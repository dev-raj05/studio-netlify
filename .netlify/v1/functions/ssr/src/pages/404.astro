---
// src/pages/404.astro
const title = "Page Not Found";
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <style>
      /* Base styling for 404 page */
      body {
        margin: 0;
        overflow: hidden; /* Prevents scrolling */
        font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
        /* Background image with dark overlay */
        background: linear-gradient(
            rgba(0, 0, 0, 0.6),
            rgba(0, 0, 0, 0.6)
          ),
          url('https://wpklik.com/wp-content/uploads/2019/03/A-404-Page-Best-Practices-and-Design-Inspiration.jpg');
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 20px;
      }
      /* Card container styling */
      .card {
        background: #fff;
        border-radius: 15px;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        padding: 2rem;
        text-align: center;
        max-width: 500px;
        width: 100%;
      }
      /* Heading style with bounce animation */
      h1 {
        font-size: 4rem;
        margin: 0 0 1rem;
        color: #16c8c7;
        animation: bounceIn 1s ease;
      }
      /* Paragraph styling */
      p {
        font-size: 1.25rem;
        margin: 0 0 1.5rem;
        color: #555;
      }
      /* Button styling */
      a {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        background-color: #16c8c7;
        color: #fff;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
        transition: background-color 0.3s ease;
      }
      a:hover {
        background-color: #0da1a0;
      }
      /* Bounce animation for h1 */
      @keyframes bounceIn {
        0% {
          opacity: 0;
          transform: scale(0.3);
        }
        50% {
          opacity: 1;
          transform: scale(1.05);
        }
        70% {
          transform: scale(0.9);
        }
        100% {
          transform: scale(1);
        }
      }
    </style>
  </head>
  <body>
    <div class="card">
      <h1>404</h1>
      <p>Oops! We can't seem to find the page you're looking for.</p>
      <p><a href="/">Go Back Home</a></p>
    </div>
  </body>
</html>
