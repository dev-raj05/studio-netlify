---
import { sanityClient } from "sanity:client";
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
import {unSlugify} from '../../lib/Slugify'
import { loadQuery } from "../../lib/load-query";
import type { SanityDocument } from "@sanity/client";




let posts;
try {
  console.log('Fetching posts from Sanity');
  const result = await loadQuery<SanityDocument[]>({
    query: `*[_type == "post"] {"tags": tags[]}`,
  });
  posts = result.data;
  // console.log('Posts fetched:', posts);
} catch (error) {
  console.error("Error fetching posts from Sanity:", error);
  posts = [];
}
// console.log('Posts after try-catch:', posts);
const allTags = [...new Set(posts.flatMap(post => post.tags || []))];
  console.log('allTags defined:', allTags);

// export const prerender = true
export async function getStaticPaths() {
  console.log('getStaticPaths running');
  return allTags.map(tag => ({
    params: { tag },
  }));
}




// export const prerender = true
// const { data: posts } = await loadQuery<SanityDocument[]>({
//     query: `*[_type == "post"]{"tags":tags[]}`,
//   });

// const posts = await sanityClient.fetch(`*[_type == "post"]{
//   "tags": tags[]
// }`);

// const allTags = [...new Set(posts.flatMap(post => post.tags || []))];

// export async function getStaticPaths() {
//   return allTags.map(tag => ({
//     params: { tag },
//   }));
// }

// Get posts related to a specific tag
const { tag } = Astro.params;

const filteredPosts = await sanityClient.fetch(
  `*[_type == "post" && $tag in tags[]]{
    title,
    "slug": slug.current,
    "mainImage": coalesce(mainImage.asset->url, ""),
    tags
  }`,
  { tag: `${unSlugify(tag)}` }
);

// console.log(tag);

// console.log(filteredPosts);
---
<Layout>
  <h1 class=" font-bold mt-10 text-center">Posts related to {unSlugify(tag)} Tag</h1>
  {filteredPosts.length  > 0 ? (<div class="mb-4 mt-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-2">
    {filteredPosts.map((post) => <Card post={post} />)}
  </div>) : <p>No post available related to this tag</p> }
  
</Layout>