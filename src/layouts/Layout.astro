---
import siteData from "../data/siteData.json";
import { VisualEditing } from '@sanity/astro/visual-editing';
import "../styles/global.css";
import Footer from '../components/Footer.astro';
import Navbar2 from '../components/Navbar2.astro';
import Cta from '../components/Cta.astro';
import Seo from '../components/Seo.astro';

const {
  title: providedTitle,
  description: providedDescription,
  image: providedImage,
  frontmatter,
  robots
} = Astro.props;

// Use fallback values from siteData if props are missing
const title = providedTitle || siteData.title;
const description = providedDescription || siteData.description;
const image = providedImage || siteData.image;

const visualEditingEnabled = import.meta.env.PUBLIC_SANITY_VISUAL_EDITING_ENABLED === 'true';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Title & Meta Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- SEO Component (includes JSON‑LD, Open Graph, Twitter tags, etc.) -->
    <Seo 
      title={title} 
      description={description} 
      url={Astro.url} 
      image={image} 
      frontmatter={frontmatter} 
      robots={robots} 
    />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={Astro.url} />
    
    <!-- Styles and Fonts -->
    <link rel="stylesheet" href="/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="flex flex-col">
    <div>
      <Navbar2 />
      <div class="flex flex-col min-h-screen mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 container">
        <main class="flex-grow sm:px-6 lg:px-8">
          <slot />
          <VisualEditing enabled={visualEditingEnabled} zIndex={1000} />
        </main>
      </div>
      <Cta />
      <Footer />
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
