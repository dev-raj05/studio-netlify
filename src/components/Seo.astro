---
import siteData from "../data/siteData.json";
import jsonLDGenerator from "../js/jsonLD";

// Destructure props with fallback values from siteData if not provided
const {
  title = siteData.title,
  description = siteData.description,
  url = Astro.url,
  image,
  frontmatter,
  robots,
} = Astro.props;

const isPost = Boolean(frontmatter);

// Generate JSON‑LD markup based on page type
const jsonLD = jsonLDGenerator({
  type: isPost ? "post" : "website",
  post: frontmatter,
  url,
});

// Determine image source and alt text
const imageSrc = image?.src || siteData.image.src;
const imageAlt = image?.alt || siteData.image.alt;

// Set Open Graph type
const ogType = isPost ? "article" : "website";
---

<!-- Title & Meta Description -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Canonical URL -->
<link rel="canonical" href={url} />

<!-- Open Graph Meta Tags -->
<meta property="og:site_name" content="Booleanmaths Blog" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageSrc} />
<meta property="og:image:url" content={imageSrc} />
<meta property="og:image:secure_url" content={imageSrc} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="600" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />

<!-- Twitter Meta Tags -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageSrc} />
<meta name="twitter:image:alt" content={imageAlt} />
<meta name="twitter:site" content="@Booleanmaths" />
<meta name="twitter:domain" content={import.meta.env.SITE || "http://localhost:4321"} />

<!-- Optional Robots Meta Tag -->
{robots && <meta name="robots" content={robots} />}

<!-- Inject the JSON‑LD script -->
<Fragment set:html={jsonLD} />
