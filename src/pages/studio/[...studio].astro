---
// src/pages/studio/[...studio].astro
import  Studio from '@sanity/astro';
import { loadQuery } from '../../lib/load-query';
import type { SanityDocument } from '@sanity/client';

// Add this function to satisfy Astro's dynamic route requirements
export async function getStaticPaths() {
    try {
        const { data: posts } = await loadQuery<SanityDocument[]>({
        query: `*[_type == "post"]`,
        });
        if (!posts || posts.length === 0) {
        console.warn("No posts found in Sanity.");
        return [];
        }
        return posts.map(({ slug,post }) => ({
        params: { slug: slug.current },
        props: { post },
        }))
    } catch (error) {
    console.error("Error fetching posts from Sanity:", error);
    return [];
  } // Empty array = root path
}

// Force prerendering
export const prerender = true;
---

<Studio />